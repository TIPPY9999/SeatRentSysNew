<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
    "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <property name="connection.driver_class">com.microsoft.sqlserver.jdbc.SQLServerDriver</property>
        <property name="connection.url">jdbc:sqlserver://localhost:1433;databaseName=SeatRentSys;encrypt=false</property>
        <property name="connection.username">kang</property>
        <property name="connection.password">1234</property>

        <property name="dialect">org.hibernate.dialect.SQLServerDialect</property>
        <property name="show_sql">true</property>
        <property name="format_sql">true</property>
        <property name="current_session_context_class">thread</property>

        <mapping class="com.example.backend.model.MerchantBean"/>
        <mapping class="com.seatrentsys.model.merchantandcoupon.discountBean" />
        <mapping class="com.seatrentsys.model.merchantandcoupon.merchantBean" />
    </session-factory>
</hibernate-configuration>
